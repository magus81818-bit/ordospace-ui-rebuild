{
  "name": "ordospace-ui-rebuild",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ordospace/web",
    "build": "npm run product:build",
    "build:react-mvp": "npm run build --workspace @ordospace/web",
    "product:validate": "node scripts/validate-product-static.mjs",
    "product:build": "npm run product:validate && node scripts/build-product-static.mjs",
    "preview": "npm run preview --workspace @ordospace/web",
    "typecheck": "npm run typecheck --workspace @ordospace/ui-catalog && npm run typecheck --workspace @ordospace/web && npm run typecheck --workspace @ordospace/ui-lab",
    "validate": "npm run validate --workspace @ordospace/web",
    "validate:tokens": "node scripts/validate-design-tokens.mjs",
    "validate:status-map": "node scripts/validate-status-map.mjs",
    "validate:source-vault": "node scripts/validate-source-vault.mjs",
    "validate:ui-catalog": "node scripts/validate-ui-catalog.mjs",
    "validate:ui-exports": "node scripts/validate-ui-exports.mjs",
    "validate:navigation": "node scripts/validate-navigation.mjs",
    "validate:route-meta": "node scripts/validate-route-meta.mjs",
    "validate:shell-contract": "node scripts/validate-shell-contract.mjs",
    "validate:dashboard-patterns": "node scripts/validate-dashboard-patterns.mjs",
    "validate:legacy-content": "node scripts/validate-legacy-content.mjs",
    "validate:module-card-view-model": "node scripts/validate-module-card-view-model.mjs",
    "validate:bundle-budget": "node scripts/validate-bundle-budget.mjs",
    "validate:admin-operations": "node scripts/validate-admin-operations.mjs",
    "validate:admin-action-policy": "node scripts/validate-admin-action-policy.mjs",
    "validate:admin-detail-contract": "node scripts/validate-admin-detail-contract.mjs",
    "validate:client-approval": "node scripts/validate-client-approval.mjs",
    "validate:client-action-policy": "node scripts/validate-client-action-policy.mjs",
    "validate:client-detail-contract": "node scripts/validate-client-detail-contract.mjs",
    "validate:worker-workspace": "node scripts/validate-worker-workspace.mjs",
    "validate:worker-action-policy": "node scripts/validate-worker-action-policy.mjs",
    "validate:worker-detail-contract": "node scripts/validate-worker-detail-contract.mjs",
    "validate:accessibility-contract": "node scripts/validate-accessibility-contract.mjs",
    "validate:responsive-contract": "node scripts/validate-responsive-contract.mjs",
    "validate:heading-landmarks": "node scripts/validate-heading-landmarks.mjs",
    "validate:role-visibility": "node scripts/validate-role-visibility.mjs",
    "validate:css-usage": "node scripts/validate-css-usage.mjs",
    "validate:visual-evidence": "node scripts/validate-visual-evidence.mjs",
    "validate:vercel-config": "node scripts/validate-vercel-config.mjs",
    "validate:production-artifact": "node scripts/validate-production-artifact.mjs",
    "validate:release-docs": "node scripts/validate-release-docs.mjs",
    "validate:deployment-safety": "node scripts/validate-deployment-safety.mjs",
    "validate:bundle-decision": "node scripts/validate-bundle-decision.mjs",
    "validate:no-production-deploy": "node scripts/validate-no-production-deploy.mjs",
    "validate:historical-evidence": "node scripts/validate-historical-evidence.mjs",
    "validate:preview-evidence": "node scripts/validate-preview-evidence.mjs",
    "validate:release": "npm run validate:vercel-config && npm run validate:production-artifact && npm run validate:release-docs && npm run validate:deployment-safety && npm run validate:bundle-decision && npm run validate:no-production-deploy && npm run validate:historical-evidence",
    "test": "node scripts/test-ui-catalog.mjs",
    "test:shell": "node scripts/test-shell.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:client": "node scripts/test-client.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:quality": "node scripts/test-quality.mjs",
    "check:quality": "npm run validate:accessibility-contract && npm run validate:responsive-contract && npm run validate:heading-landmarks && npm run validate:role-visibility && npm run validate:css-usage && npm run test:quality",
    "check": "npm run typecheck && npm run validate && npm run validate:tokens && npm run validate:status-map && npm run validate:source-vault && npm run validate:ui-catalog && npm run validate:ui-exports && npm run validate:navigation && npm run validate:route-meta && npm run validate:shell-contract && npm run validate:dashboard-patterns && npm run validate:legacy-content && npm run validate:module-card-view-model && npm run validate:admin-operations && npm run validate:admin-action-policy && npm run validate:admin-detail-contract && npm run validate:client-approval && npm run validate:client-action-policy && npm run validate:client-detail-contract && npm run validate:worker-workspace && npm run validate:worker-action-policy && npm run validate:worker-detail-contract && npm run test && npm run test:shell && npm run test:dashboard && npm run test:admin && npm run test:client && npm run test:worker && npm run check:quality && npm run validate:visual-evidence && npm run build:react-mvp && npm run validate:bundle-budget && npm run ui-lab:build && npm run product:build",
    "smoke": "npm run smoke --workspace @ordospace/web",
    "smoke:preview": "npm run smoke:preview --workspace @ordospace/web",
    "smoke:deployment": "node apps/web/scripts/smoke-browser.cjs",
    "visual:ui-lab": "node scripts/visual-qa-ui-lab.mjs",
    "visual:web-shell": "node scripts/visual-qa-web-shell.mjs",
    "visual:web-dashboard": "node scripts/visual-qa-web-shell.mjs --dashboard",
    "visual:web-admin": "node scripts/visual-qa-web-shell.mjs --admin",
    "visual:web-client": "node scripts/visual-qa-web-shell.mjs --client",
    "visual:web-worker": "node scripts/visual-qa-web-shell.mjs --worker",
    "visual:web-all": "node scripts/visual-qa-web-shell.mjs --all",
    "visual:web-accessibility": "node scripts/visual-qa-web-shell.mjs --accessibility",
    "visual:web-long-content": "node scripts/visual-qa-web-shell.mjs --long-content",
    "visual:web-quality": "npm run visual:web-accessibility && npm run visual:web-long-content",
    "visual": "npm run visual:web-all",
    "visual:deployment": "node scripts/visual-qa-web-shell.mjs",
    "ui-lab:dev": "npm run dev --workspace @ordospace/ui-lab",
    "ui-lab:build": "npm run build --workspace @ordospace/ui-lab"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
